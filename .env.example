# Copier en .env (non versionné) et remplir les valeurs.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yohan
POSTGRES_USER=yohan
POSTGRES_PASSWORD=change-me

# Clé de signature des JWT : au moins 32 caractères aléatoires (ex. `openssl rand -base64 48`)
JWT_SECRET=change-me-with-at-least-32-random-characters

# Cookies Secure : laisser true (localhost est considéré sûr par les navigateurs, même en http)
COOKIE_SECURE=true

# Premier administrateur, créé au démarrage s'il n'existe aucun admin.
# Le pseudo doit respecter le format nom-000000.
ADMIN_PSEUDO=admin-000000
ADMIN_PASSWORD=change-me

# Stockage objet compatible S3 (SeaweedFS via docker compose en dev, n'importe quel fournisseur S3 en prod)
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=yohan
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too

# Taille maximale du PDF d'une histoire (ex. 20MB, 500KB)
STORY_PDF_MAX_SIZE=20MB
