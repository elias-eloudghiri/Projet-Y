# Copier en .env (non versionné) et remplir les valeurs.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yohan
POSTGRES_USER=yohan
POSTGRES_PASSWORD=change-me

# Clé de signature des JWT : au moins 32 caractères aléatoires (ex. `openssl rand -base64 48`)
JWT_SECRET=change-me-with-at-least-32-random-characters

# Cookies Secure : laisser true (localhost est considéré sûr par les navigateurs, même en http)
COOKIE_SECURE=true

# Premier administrateur, créé au démarrage s'il n'existe aucun admin.
# Le pseudo doit respecter le format nom-000000.
ADMIN_PSEUDO=admin-000000
ADMIN_PASSWORD=change-me
